{
  "name": "amazon-power-search",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Firefox extension: collect every result an Amazon search will give and sort/filter it yourself.",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "web-ext lint",
    "run": "web-ext run --source-dir . --firefox-profile ${APS_PROFILE:-/tmp/aps-profile} --keep-profile-changes --no-reload",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "web-ext": "^8.3.0"
  }
}
